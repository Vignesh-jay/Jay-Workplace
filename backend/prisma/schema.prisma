generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Department {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?
  status      Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Location {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String

  city        String?
  state       String?
  country     String?
  address     String?

  status      Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
